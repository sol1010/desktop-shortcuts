<Window x:Class="DesktopShortcuts.TodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopShortcuts"
        Title="투두" Width="304" MinWidth="124" MinHeight="120" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False"
        ShowActivated="False" WindowStartupLocation="Manual" UseLayoutRounding="True"
        FontFamily="Malgun Gothic">
  <Window.Resources>
    <Style x:Key="DoneBox" TargetType="CheckBox">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border Background="Transparent" Padding="3" Width="22" Height="23">
              <Border x:Name="CheckSurface" Width="14" Height="14" CornerRadius="3"
                      BorderThickness="1" BorderBrush="#80D9CAFF">
                <Path x:Name="Mark" Data="M 1,4 L 4,7 L 9,1" StrokeThickness="1.6"
                      Stroke="{DynamicResource ShortcutFolderBrush}" StrokeLineJoin="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
              </Border>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CheckSurface" Property="Background" Value="#23D9CAFF" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="CheckSurface" Property="Background" Value="#38D9CAFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TaskEditor" TargetType="TextBox" BasedOn="{StaticResource WidgetEditor}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsDone}" Value="True">
          <Setter Property="TextDecorations" Value="Strikethrough" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <ContextMenu x:Key="ItemMenu" x:Shared="False"
                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="항목 복사" Click="CopyItem" />
      <MenuItem Header="항목 삭제" Click="RemoveItem" />
    </ContextMenu>
    <DataTemplate x:Key="ChildItem">
      <Grid Margin="22,1,0,1" ContextMenu="{StaticResource ItemMenu}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <CheckBox Style="{StaticResource DoneBox}" IsChecked="{Binding IsDone}" Click="CheckChanged"
                  AutomationProperties.Name="하위 투두 완료" />
        <TextBox Grid.Column="1" Style="{StaticResource TaskEditor}" Tag="하위 투두"
                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" TextChanged="ContentChanged"
                 Loaded="TaskInputLoaded" AutomationProperties.Name="하위 투두 내용" ContextMenu="{StaticResource ItemMenu}" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ParentItem">
      <StackPanel Margin="0,0,0,3">
        <Grid ContextMenu="{StaticResource ItemMenu}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <CheckBox Style="{StaticResource DoneBox}" IsChecked="{Binding IsDone}" Click="CheckChanged"
                    AutomationProperties.Name="투두 완료" />
          <TextBox Grid.Column="1" Style="{StaticResource TaskEditor}" Tag="할 일"
                   Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" TextChanged="ContentChanged"
                   Loaded="TaskInputLoaded" AutomationProperties.Name="투두 내용" ContextMenu="{StaticResource ItemMenu}" />
          <Button Grid.Column="2" Style="{StaticResource WidgetButton}" Content="+" Click="AddChild"
                  ToolTip="하위 투두 추가" AutomationProperties.Name="하위 투두 추가" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{StaticResource ChildItem}" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="StandaloneHost">
    <Grid x:Name="WidgetSurface">
      <Border x:Name="Card" Background="{DynamicResource ShortcutBackground}"
              CornerRadius="{DynamicResource ShortcutCornerRadius}" Padding="8,6,8,8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="TasksRow" Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="MemoRow" Height="84" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,3">
            <Button x:Name="AddRootButton" DockPanel.Dock="Right" Style="{StaticResource WidgetButton}" Width="22" Content="+"
                    Click="AddRoot" ToolTip="투두 추가" AutomationProperties.Name="투두 추가" />
            <Button DockPanel.Dock="Right" Style="{StaticResource WidgetButton}" Width="50" FontSize="10"
                    Content="{Binding DateCaption}" Click="OpenCalendar" ToolTip="달력에서 날짜 선택" />
            <Border x:Name="DragArea" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="DragHeading" MouseMove="ContinueDockedDrag" MouseLeftButtonUp="EndDockedPress"
                    ToolTip="끌어서 이동 · 우클릭으로 설정">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="투두" VerticalAlignment="Center" FontSize="13"
                           FontWeight="SemiBold" Foreground="{DynamicResource ShortcutLabelBrush}" Margin="0,0,8,0" />
                <Border Height="1" VerticalAlignment="Center" Background="#39D9CAFF" Margin="0,0,5,0" />
              </DockPanel>
            </Border>
          </DockPanel>
          <ScrollViewer x:Name="TaskScroll" Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Margin="0,0,0,3">
            <ScrollViewer.Resources>
              <Style TargetType="ScrollBar" BasedOn="{StaticResource WidgetScrollBar}" />
            </ScrollViewer.Resources>
            <ItemsControl x:Name="TaskList" ItemsSource="{Binding Day.Items}" ItemTemplate="{StaticResource ParentItem}" />
          </ScrollViewer>
          <DockPanel Grid.Row="2" Margin="0,0,0,4">
            <TextBlock DockPanel.Dock="Left" Text="메모" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource ShortcutLabelBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Border Height="1" VerticalAlignment="Center" Background="#39D9CAFF" />
          </DockPanel>
          <Border Grid.Row="3" Background="#1807091B" CornerRadius="5" Padding="2">
            <TextBox x:Name="NoteInput" Style="{StaticResource WidgetEditor}" FontSize="11" Padding="3,1" Tag="메모 입력" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="메모"
                     Text="{Binding Day.Note, UpdateSourceTrigger=PropertyChanged}" />
          </Border>
          <TextBlock x:Name="SaveStatus" Grid.Row="4" Foreground="#FFFFC6B6" FontSize="11" Margin="0,5,0,0"
                     TextWrapping="Wrap" Visibility="{Binding SaveFailed, Converter={StaticResource WidgetBooleanVisibility}}" Text="저장할 수 없습니다. 다시 시도 중입니다."
                     AutomationProperties.LiveSetting="Polite" />
        </Grid>
      </Border>
      <local:WidgetResizeLayer x:Name="ResizeLayer" />
    </Grid>
  </Border>
</Window>
