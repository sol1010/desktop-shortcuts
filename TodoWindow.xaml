<Window x:Class="DesktopShortcuts.TodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopShortcuts"
        Title="할 일" Width="304" MinWidth="124" MinHeight="120" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False"
        ShowActivated="False" WindowStartupLocation="Manual" UseLayoutRounding="True"
        FontFamily="Malgun Gothic">
  <Window.Resources>
    <Style x:Key="DoneBox" TargetType="CheckBox">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border Background="Transparent" Padding="3" Width="22" Height="23">
              <Border x:Name="CheckSurface" Width="14" Height="14" CornerRadius="3"
                      BorderThickness="1" BorderBrush="#80D9CAFF">
                <Path x:Name="Mark" Data="M 1,4 L 4,7 L 9,1" StrokeThickness="1.6"
                      Stroke="{DynamicResource ShortcutFolderBrush}" StrokeLineJoin="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
              </Border>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CheckSurface" Property="Background" Value="#23D9CAFF" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="CheckSurface" Property="Background" Value="#38D9CAFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TaskEditor" TargetType="TextBox" BasedOn="{StaticResource WidgetEditor}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsDone}" Value="True">
          <Setter Property="TextDecorations" Value="Strikethrough" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TaskDragHandle" TargetType="Border">
      <Setter Property="Width" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="SizeAll" />
      <Setter Property="ToolTip" Value="끌어서 순서를 바꾸거나 다른 날짜로 이동" />
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="PressItemDrag" />
      <EventSetter Event="PreviewMouseMove" Handler="ContinueItemDrag" />
      <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ReleaseItemDrag" />
      <EventSetter Event="GiveFeedback" Handler="ShowItemDragCursor" />
    </Style>
    <DataTemplate x:Key="TaskGrip">
      <TextBlock Text="⋮" FontSize="12" Foreground="{DynamicResource ShortcutLabelBrush}" Opacity="0.6"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </DataTemplate>
    <ContextMenu x:Key="ItemMenu" x:Shared="False"
                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="항목 복사" Click="CopyItem" />
      <MenuItem Header="항목 삭제" Click="RemoveItem" />
    </ContextMenu>
    <DataTemplate x:Key="ChildItem">
      <local:TaskDropRow Margin="22,1,0,1" Background="Transparent" ContextMenu="{StaticResource ItemMenu}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource TaskDragHandle}">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TaskGrip}" />
          </Border>
          <CheckBox Grid.Column="1" Style="{StaticResource DoneBox}" IsChecked="{Binding IsDone}" Click="CheckChanged"
                    AutomationProperties.Name="하위 할 일 완료" />
          <TextBox Grid.Column="2" Style="{StaticResource TaskEditor}" Tag="하위 할 일"
                   Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" TextChanged="ContentChanged"
                   Loaded="TaskInputLoaded" AutomationProperties.Name="하위 할 일 내용" ContextMenu="{StaticResource ItemMenu}" />
        </Grid>
      </local:TaskDropRow>
    </DataTemplate>
    <DataTemplate x:Key="ParentItem">
      <local:TaskDropRow Margin="0,0,0,3" Background="Transparent">
        <StackPanel>
          <Grid ContextMenu="{StaticResource ItemMenu}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource TaskDragHandle}">
              <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TaskGrip}" />
            </Border>
            <CheckBox Grid.Column="1" Style="{StaticResource DoneBox}" IsChecked="{Binding IsDone}" Click="CheckChanged"
                      AutomationProperties.Name="할 일 완료" />
            <TextBox Grid.Column="2" Style="{StaticResource TaskEditor}" Tag="할 일"
                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" TextChanged="ContentChanged"
                     Loaded="TaskInputLoaded" AutomationProperties.Name="할 일 내용" ContextMenu="{StaticResource ItemMenu}" />
            <Button x:Name="ChildrenToggle" Grid.Column="3" Style="{StaticResource WidgetButton}" Width="26" FontSize="9"
                    Opacity="0.65" Click="ToggleChildren" ToolTip="하위 할 일 접기" AutomationProperties.Name="하위 할 일 접기">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ChildrenArrow" Text="▾" />
                <TextBlock Text="{Binding Children.Count}" Margin="2,0,0,0" />
              </StackPanel>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource WidgetButton}" Width="20" Content="+" Click="AddChild"
                    ToolTip="하위 할 일 추가" AutomationProperties.Name="하위 할 일 추가" />
          </Grid>
          <ItemsControl x:Name="ChildList" ItemsSource="{Binding Children}" ItemTemplate="{StaticResource ChildItem}" />
        </StackPanel>
      </local:TaskDropRow>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Children.Count}" Value="0">
          <Setter TargetName="ChildrenToggle" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding AreChildrenCollapsed}" Value="True">
          <Setter TargetName="ChildList" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="ChildrenArrow" Property="Text" Value="▸" />
          <Setter TargetName="ChildrenToggle" Property="ToolTip" Value="하위 할 일 펼치기" />
          <Setter TargetName="ChildrenToggle" Property="AutomationProperties.Name" Value="하위 할 일 펼치기" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="StandaloneHost">
    <Grid x:Name="WidgetSurface">
      <local:WidgetCard x:Name="Card" ThemeBackground="{DynamicResource ShortcutBackground}"
                        CornerRadius="{DynamicResource ShortcutCornerRadius}" Padding="8,6,8,8">
        <Grid x:Name="TodoLayout">
          <Grid.RowDefinitions>
            <RowDefinition x:Name="TodoHeadingRow" Height="Auto" />
            <RowDefinition x:Name="TasksRow" Height="Auto" />
            <RowDefinition x:Name="MemoHeadingRow" Height="Auto" />
            <RowDefinition x:Name="MemoRow" Height="Auto" />
            <RowDefinition x:Name="TodoStatusRow" Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,3">
            <Button x:Name="AddRootButton" DockPanel.Dock="Right" Style="{StaticResource WidgetButton}" Width="22" Content="+"
                    Click="AddRoot" ToolTip="할 일 추가" AutomationProperties.Name="할 일 추가" />
            <Button DockPanel.Dock="Right" Style="{StaticResource WidgetButton}" Width="50" FontSize="10"
                    Content="{Binding DateCaption}" Click="OpenCalendar" ToolTip="달력에서 날짜 선택" />
            <Border x:Name="DragArea" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="DragHeading" MouseMove="ContinueDockedDrag" MouseLeftButtonUp="EndDockedPress"
                    ToolTip="끌어서 이동 · 우클릭으로 설정">
              <DockPanel>
                <Viewbox DockPanel.Dock="Left" StretchDirection="DownOnly" Margin="0,0,5,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="할 일" VerticalAlignment="Center" FontSize="13"
                               FontWeight="SemiBold" Foreground="{DynamicResource ShortcutLabelBrush}" />
                    <TextBlock x:Name="TaskCount" Text="{Binding TaskCountCaption}" VerticalAlignment="Center"
                               FontSize="9" Foreground="{DynamicResource ShortcutLabelBrush}" Opacity="0.65" Margin="4,0,0,0"
                               ToolTip="하위 할 일 수 / 상위 할 일 수" AutomationProperties.Name="하위 할 일 수 / 상위 할 일 수" />
                  </StackPanel>
                </Viewbox>
                <Border Height="1" VerticalAlignment="Center" Background="#39D9CAFF" Margin="0,0,5,0" />
              </DockPanel>
            </Border>
          </DockPanel>
          <ScrollViewer x:Name="TaskScroll" Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Margin="0,0,0,3" AllowDrop="True" PreviewDragEnter="DragOverTask" PreviewDragOver="DragOverTask"
                        PreviewDragLeave="LeaveTaskList" PreviewDrop="DropOnTask">
            <ScrollViewer.Resources>
              <Style TargetType="ScrollBar" BasedOn="{StaticResource WidgetScrollBar}" />
            </ScrollViewer.Resources>
            <ItemsControl x:Name="TaskList" ItemsSource="{Binding Day.Items}" ItemTemplate="{StaticResource ParentItem}" />
          </ScrollViewer>
          <DockPanel Grid.Row="2" Margin="0,0,0,4">
            <TextBlock DockPanel.Dock="Left" Text="메모" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource ShortcutLabelBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Grid>
              <Thumb x:Name="MemoDivider" Style="{StaticResource WidgetSectionDivider}"
                     ToolTip="끌어서 할 일과 메모의 높이 조절" AutomationProperties.Name="할 일과 메모의 높이 조절" />
              <Border x:Name="CompactMemoLine" Height="1" VerticalAlignment="Center" Background="#39D9CAFF" Visibility="Collapsed" />
            </Grid>
          </DockPanel>
          <Border x:Name="MemoBody" Grid.Row="3" Background="#1807091B" CornerRadius="5" Padding="2">
            <TextBox x:Name="NoteInput" Style="{StaticResource WidgetEditor}" FontSize="11" Padding="3,1" Tag="메모 입력" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="할 일 메모"
                     Text="{Binding Day.TodoNote, UpdateSourceTrigger=PropertyChanged}" TextChanged="MemoTextChanged" />
          </Border>
          <TextBlock x:Name="SaveStatus" Grid.Row="4" Foreground="#FFFFC6B6" FontSize="11" Margin="0,5,0,0"
                     TextWrapping="Wrap" Visibility="{Binding SaveFailed, Converter={StaticResource WidgetBooleanVisibility}}" Text="저장할 수 없습니다. 다시 시도 중입니다."
                     AutomationProperties.LiveSetting="Polite" />
        </Grid>
      </local:WidgetCard>
      <local:WidgetResizeLayer x:Name="ResizeLayer" />
    </Grid>
  </Border>
</Window>
