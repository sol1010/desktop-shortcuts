<Window x:Class="DesktopShortcuts.ShortcutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopShortcuts"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True">
  <Grid x:Name="Surface" Cursor="Hand"
        PreviewMouseLeftButtonDown="Press" PreviewMouseMove="Drag"
        PreviewMouseLeftButtonUp="Release" LostMouseCapture="CancelPress"
        ToolTipService.InitialShowDelay="700">
    <Viewbox StretchDirection="DownOnly">
      <local:WidgetCard x:Name="Tile" CornerRadius="{DynamicResource ShortcutCornerRadius}">
        <local:WidgetCard.Style>
          <Style TargetType="local:WidgetCard">
            <Setter Property="ThemeBackground" Value="{DynamicResource ShortcutBackground}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="ThemeBackground" Value="{DynamicResource ShortcutSelectionBackground}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </local:WidgetCard.Style>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid x:Name="IconFace">
            <Image x:Name="ProgramImage" Stretch="Uniform" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <Viewbox x:Name="FolderGlyph">
              <Canvas Width="24" Height="24">
                <Path Data="M 2.5,6.5 Q 2.5,4.5 4.5,4.5 H 9 L 12,7.5 H 19.5 Q 21.5,7.5 21.5,9.5 V 17.5 Q 21.5,19.5 19.5,19.5 H 4.5 Q 2.5,19.5 2.5,17.5 Z"
                      Stroke="{DynamicResource ShortcutFolderBrush}" StrokeThickness="1.85" StrokeLineJoin="Round" />
              </Canvas>
            </Viewbox>
            <Viewbox x:Name="CalendarGlyph" Visibility="Collapsed">
              <Canvas Width="24" Height="24">
                <Rectangle Canvas.Left="3.3" Canvas.Top="5.2" Width="17.4" Height="15" RadiusX="2.7" RadiusY="2.7"
                           Stroke="{DynamicResource ShortcutFolderBrush}" StrokeThickness="1.8" />
                <Path Data="M 8,3.4 V 7 M 16,3.4 V 7 M 4.2,10 H 19.8 M 8,14.5 H 9 M 12,14.5 H 13 M 16,14.5 H 17"
                      Stroke="{DynamicResource ShortcutFolderBrush}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              </Canvas>
            </Viewbox>
            <Viewbox x:Name="ProgramGlyph" Visibility="Collapsed">
              <Canvas Width="48" Height="48">
                <Rectangle Canvas.Left="5" Canvas.Top="9" Width="38" Height="30" RadiusX="5" RadiusY="5"
                           Fill="#478FBAFF" Stroke="#FFDAEAFF" StrokeThickness="2.2" />
                <Path Data="M 6,17 H 42 M 13,24 L 18,28 L 13,32 M 23,32 H 32"
                      Stroke="#FFDAEAFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              </Canvas>
            </Viewbox>
          </Grid>
          <TextBlock x:Name="LabelText" Grid.Row="1" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                     Margin="0,1,0,0" FontFamily="Malgun Gothic" FontWeight="Light"
                     FontSize="{DynamicResource ShortcutLabelFontSize}" Foreground="{DynamicResource ShortcutLabelBrush}" />
        </Grid>
      </local:WidgetCard>
    </Viewbox>
    <Border x:Name="ReorderHighlight" BorderBrush="{DynamicResource ShortcutFolderBrush}" BorderThickness="2"
            CornerRadius="{DynamicResource ShortcutCornerRadius}" Visibility="Collapsed" IsHitTestVisible="False" />
  </Grid>
</Window>
